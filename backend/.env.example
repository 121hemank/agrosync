PORT=5000

# Authentication
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Supabase (PostgreSQL + storage)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# CORS
FRONTEND_URL=http://localhost:5173

# Email — SendGrid Web API (recommended: works on cloud/Render, HTTPS not SMTP)
# NOTE: SendGrid SMTP + Gmail SMTP are BLOCKED on Render free tier (ports 25/465/587).
# The SendGrid Web API runs over HTTPS (443) and is not blocked. Just set the key:
SENDGRID_API_KEY=your_sendgrid_api_key   # starts with SG.
EMAIL_FROM=AgroSync AI <your_verified_sender@example.com>

# Alternative email providers (fallback, in order)
# Resend (requires a verified domain; HTTPS so it also works on Render)
RESEND_API_KEY=
RESEND_FROM=AgroSync AI <noreply@your-verified-domain.com>
# Generic SMTP (works locally / on paid hosting without SMTP port blocks)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
